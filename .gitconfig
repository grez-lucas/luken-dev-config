[init]
	defaultBranch = main
[user]
	email = lucasgrez3010@gmail.com
	name = grez-lucas
	signingkey = /home/luken/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
# Machine-local work credentials and hosts. Untracked on purpose: this repo is
# public. Git skips a missing include, so other machines are unaffected.
[include]
	path = ~/.config/git/work.gitconfig
